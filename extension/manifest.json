{
  "manifest_version": 3,
  "name": "金融雷達 NotebookLM 助手",
  "version": "0.6.3",
  "description": "匯入網頁 / 剪貼簿 URL 至 NotebookLM（動態列出 / 建立筆記本，可同時對多個筆記本並行操作）、清空 sources（保留 [SKILL]）、產生分析報告並推送至金融雷達系統。每個任務可獨立取消。",
  "permissions": [
    "storage",
    "clipboardRead",
    "notifications",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://notebooklm.google.com/*",
    "http://34.23.154.194/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "金融雷達 NotebookLM 助手"
  },
  "options_page": "options.html"
}
